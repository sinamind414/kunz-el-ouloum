# Kunz El Ouloum — SVT BAC DZ (100 % hors-ligne côté élève)
# L'app fonctionne sans aucune clé API. Variables serveur (comptes/suivi) :

# PORT : port HTTP du serveur Express (défaut 3000)
PORT="3000"

# NODE_ENV : "development" (Vite middleware) ou "production" (sert ./dist)
NODE_ENV="development"

# ── Stockage ──────────────────────────────────────────────────────────
# Défaut : SQLite monobloc (zéro service externe).
KUNZ_DB_FILE="data/students.db"

# Option POSTGRESQL (échelle) : si défini, le serveur utilise PostgreSQL
# (même contrat d'API — parité testée). Sinon SQLite.
# DATABASE_URL="postgres://boussole:mo-de-passe@127.0.0.1:5432/boussole"

# ── Sécurité ──────────────────────────────────────────────────────────
# JWT_SECRET : OBLIGATOIRE en production (sinon les jetons sont forgeables).
# Une valeur de modèle du dépôt est REFUSÉE au démarrage en production.
# JWT_SECRET="chaine-aleatoire-de-64-caracteres"

# ── Docker compose (échelle PostgreSQL) ───────────────────────────────
# docker-compose.yml EXIGE ces trois variables : sans elles, `docker compose up`
# échoue (syntaxe ${VAR:?}). Copiez ce fichier en .env et remplissez :
# POSTGRES_PASSWORD="mot-de-passe-fort"          # base PostgreSQL + DATABASE_URL
# JWT_SECRET="openssl rand -hex 32"              # signature des jetons
# ADMIN_PASSWORD="mot-de-passe-enseignant"       # compte amorcé au 1er démarrage
# ADMIN_EMAIL="maitre@ecole.dz"                  # (facultatif, valeur par défaut)

# ── Compte enseignant (amorcé au premier démarrage) ───────────────────
# ADMIN_EMAIL="maitre@ecole.dz"
# ADMIN_PASSWORD="change-moi-strong-123"

# ── Derrière nginx / Caddy ────────────────────────────────────────────
# TRUST_PROXY="1"   # req.ip = IP réelle de l'élève (limiteur + logs)
# HTTPS obligatoire en production (aucun mot de passe en clair sur le réseau)

# ── SUPABASE — OPTIONNEL (100 % hors-ligne par défaut) ─────────────────
# Si ces variables sont absentes, l'app fonctionne entièrement hors-ligne :
# le client reste null et le SDK n'est même pas téléchargé au démarrage.
# Renseignez-les UNIQUEMENT pour activer Auth/Télémétrie Supabase en plus.
# VITE_SUPABASE_URL="https://votre-projet.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOi…"
