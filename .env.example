# M4 — Web Push (VAPID)
# Générer les clés : node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# Clé publique exposée au client (Vite) — peut être commitée.
VITE_VAPID_PUBLIC_KEY=remplacez_par_votre_cle_publique_vapid
# Email utilisé dans l'en-tête VAPID.
VAPID_EMAIL=mailto:push@kunz-el-ouloum.dz
# Clé privée côté serveur UNIQUEMENT (ne jamais committer) :
# VAPID_PRIVATE_KEY=remplacez_par_votre_cle_privee_vapid

# Variables exigées par docker-compose (voir verrouSecretsCompose.test.ts)
POSTGRES_PASSWORD=remplacez_par_un_mot_de_passe_fort
JWT_SECRET=remplacez_par_un_secret_de_signature_64_caracteres
ADMIN_PASSWORD=remplacez_par_le_mot_de_passe_enseignant
