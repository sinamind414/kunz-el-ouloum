+// ============================================================
+// BOUSSOLE v3 — suite de tests de régression (exécutable via « npm test »)
+// Verrouille les garanties établies lots H→R :
+//   · duel Scoreur vs Boussole (12 réponses-modèles → ICM 100, 0 erreur)
+//   · étalonnage du grading (8 profils → ICM + stage exacts)
+//   · les 20 vraies règles de critères (plus aucun fallback « longueur »)
+//   · les 4 régressions critiques (vrais coupables toujours détectés)
+//   · l'arabe agglutiné ne punit plus («الأنسولين»⊅«لأنّ», «العلاقة»⊅«لعل»)
+//   · boussoleData : مفتاح des 12 verbes + adresses des erreurs
+// 100 % offline, sans dépendance : tsx + Node seulement.
+// ============================================================
+import { evaluateStudentProduction } from '../src/utils/methodologyScorer';
+import { getSwitchForVerb, groupErrorsByAddress, switchPathAr, getStep } from '../src/data/boussoleData';
+
+let pass = 0;
+let fail = 0;
+const failures: string[] = [];
+
+function check(name: string, ok: boolean, detail = ''): void {
+  if (ok) { pass++; }
+  else { fail++; failures.push(`${name}${detail ? ' — ' + detail : ''}`); console.error(`  ✗ ${name}${detail ? ' — ' + detail : ''}`); }
+}
+
+function evalCase(v: string, text: string, sw: 'open' | 'closed') {
+  return evaluateStudentProduction(v, text, undefined, 3, { switchChoice: sw, switchTruth: sw });
+}
+
+// ─────────────────────────────────────────────
+// SECTION A — DUEL : 12 réponses-modèles (gabarits de la fiche) → ICM 100, 0 erreur
+// ─────────────────────────────────────────────
+const DUEL: { v: string; sw: 'open' | 'closed'; text: string }[] = [
+  { v: 'verb_analyse_v1', sw: 'closed', text:
+    'انطلاقًا من الوثيقة 1، تمثل منحنى تطور الغليسيما عند شخص سليم. نلاحظ ارتفاعًا من 0.9 غ/ل إلى 1.6 غ/ل بعد 30 دقيقة، ثم انخفاضًا إلى 0.9 غ/ل بعد 120 دقيقة. الاستنتاج: الغليسيما تنتظم حول 0.9 غ/ل في الجسم السليم.' },
+  { v: 'verb_explain_v1', sw: 'open', text:
+    'انطلاقًا من الوثيقة 1، نمثل منحنى تطور الغليسيما بعد وجبة غذائية. نلاحظ ارتفاعًا من 0.9 غ/ل إلى 1.6 غ/ل بعد 30 دقيقة ثم عودة إلى 0.9 غ/ل بعد 120 دقيقة. وهذا لأنّ ارتفاع الغليسيما يحرّض خلايا بيتا في البنكرياس على إفراز الأنسولين، الذي يجعل الكبد يخزن الغلوكوز على شكل غليكوجين، فتنخفض الغليسيما. ومنه نستنتج أنّ البنكرياس ينظم الغليسيما بفضل الأنسولين.' },
+  { v: 'verb_compare_v1', sw: 'closed', text:
+    'انطلاقًا من الوثيقتين 1 و2، نمثل جدولين يبينان النشاط الإنزيمي في وسطيين مختلفين. أوجه التشابه: يتشابهان في درجة الحرارة المثلى 37°. أوجه الاختلاف: في حين يختلفان في الرقم الهيدروجيني الأمثل، وفي المقابل لا يختلفان في كمية الإنزيم. ومنه نستنتج أنّ الرقم الهيدروجيني يلعب دورًا مهمًا في النشاط الإنزيمي.' },
+  { v: 'verb_hypothesis_v1', sw: 'open', text:
+    'انطلاقًا من الوثيقة 1، نلاحظ أنّ الخلايا المعالجة بالدواء توقفت عن إنتاج البروتين بينما الخلايا الشاهدة واصلت إنتاجه. فما العلاقة بين الدواء والريبوزوم؟ الفرضية: يثبط الدواء عمل الريبوزومات، فيتوقف تركيب البروتين داخل الخلية. الاستنتاج: الدواء يثبط الترجمة على مستوى الريبوزوم.' },
+  { v: 'verb_deduce_v1', sw: 'closed', text:
+    'انطلاقًا من الوثيقة 1، نلاحظ أن الغليسيما ترتفع بعد الوجبة من 0.9 غ/ل إلى 1.6 غ/ل، ثم تعود إلى 0.9 غ/ل بعد 120 دقيقة. الاستنتاج: ارتفاع الغليسيما يحرّض البنكرياس على إفراز الأنسولين الذي يخزن الغلوكوز في الكبد.' },
+  { v: 'verb_validate_v1', sw: 'open', text:
+    'انطلاقًا من الوثيقة 1، نمثل منحنى الغليسيما بعد حقن الأنسولين. الفرضية: الأنسولين يخفض الغليسيما. نلاحظ أن الغليسيما تنخفض من 1.6 غ/ل إلى 0.9 غ/ل بعد حقن الأنسولين، وهذا يؤكد الفرضية ويتوافق معها. ومنه نستنتج أن الأنسولين يخفض الغليسيما.' },
+  { v: 'verb_explain_multi_v1', sw: 'open', text:
+    'تمثل الوثيقة 1 منحنى الغليسيما: نلاحظ ارتفاعًا بعد الوجبة ثم عودة إلى 0.9 غ/ل. وتمثل الوثيقة 2 تطور الغليكوجين: نلاحظ ارتفاعه في الكبد بعد الوجبة. وهذا لأنّ الأنسولين يحفز الخزن. الاستنتاج: الكبد ينظم الغليسيما بتحريض الأنسولين.' },
+  { v: 'verb_justify_v1', sw: 'open', text:
+    'أعلن أن الأنسولين يخفض الغليسيما. نلاحظ في الوثيقة 1 أن الغليسيما تعود إلى 0.9 غ/ل بعد 120 دقيقة. نعلم أن الأنسولين يخزن الغلوكوز على شكل غليكوجين في الكبد. وبالتالي يخفض الأنسولين الغليسيما. الاستنتاج: الكبد يخفض الغليسيما بتحريض الأنسولين.' },
+  { v: 'verb_schema_v1', sw: 'closed', text:
+    'انطلاقًا من الوثيقة 1، أضع العناصر الفاعلة (الأنسولين، الريبوزوم، الغلوكوز) داخل أشكال منظمة: مربعات ودوائر. أحدد اتجاه الأسهم: يتحول الغلوكوز إلى غليكوجين في الكبد. الاستنتاج: يخزن الكبد الغلوكوز بتحريض الأنسولين.' },
+  { v: 'verb_schematic_v1', sw: 'closed', text:
+    'أرسم البنيات بمربعات بسيطة: الخلية، النواة، الريبوزوم. أسمي كل بنية بسهم أفقي. أميز الظواهر بأسهم مرقمة: 1 دخول الدواء إلى الخلية، 2 تثبيت الدواء على الريبوزوم. أضع مفتاح الأرقام أسفل الرسم وعنوانًا شاملا: تأثير الدواء على التركيب البروتيني.' },
+  { v: 'verb_critique_v1', sw: 'open', text:
+    'أنتقد نموذج الدواء كعلاج وحيد: أعلن أن موضوع النقد هو الاعتماد الكامل على الدواء. من الإيجابيات أنه يقلل الأعراض، كما نلاحظ في الوثيقة 2. من السلبيات والحدود أنه لا يعالج سبب المرض، وتظهر حدود الجرعات. في رأيي يجب دمج الدواء مع تنظيم الحياة اليومية. الاستنتاج: الدواء علاج مساعد وليس وحيدا.' },
+  { v: 'verb_composer_v1', sw: 'open', text:
+    'مقدمة: تتعرض الخلايا الحية لعوامل خارجية تؤثر على نشاطها، فما هي العلاقة بين الدواء والريبوزوم؟ يظهر في الوثيقة 1 أن الدواء يثبط الترجمة على مستوى الريبوزوم، وبالتالي يتوقف تركيب البروتين. النواة تحمل المعلومة الوراثية وتنسخها، ويرجمه الريبوزوم إلى أحماض أمينية. ومنه نستنتج أن الدواء يثبط عمل الريبوزوم ويوقف التعبير المورثي. الخلاصة: الدواء يثبط الترجمة فيقل إنتاج البروتين.' },
+];
+
+console.log('── SECTION A : duel (12 réponses-modèles → ICM 100, 0 erreur) ──');
+for (const c of DUEL) {
+  const rep = evalCase(c.v, c.text, c.sw);
+  const fails = rep.criteriaResults.filter(x => !x.passed).map(x => x.criterionId);
+  check(`duel ${c.v}`, rep.icm === 100 && fails.length === 0 && rep.detectedErrors.length === 0,
+    `ICM=${rep.icm} échoués=[${fails.join(',')}] erreurs=[${rep.detectedErrors.map(e => e.tag).join(',')}]`);
+}
+
+// ─────────────────────────────────────────────
+// SECTION B — ÉTALONNAGE : 8 profils → ICM + stage exacts
+// ─────────────────────────────────────────────
+console.log('── SECTION B : étalonnage du grading (8 profils) ──');
+{
+  const p0 = evalCase('verb_explain_v1', DUEL[1].text, 'open');
+  check('P0 élite → ICM 100 · stade 4', p0.icm === 100 && p0.nextPedagogicalStage === 4, `ICM=${p0.icm} stade=${p0.nextPedagogicalStage}`);
+
+  const p1 = evalCase('verb_analyse_v1',
+    'انطلاقًا من الوثيقة 1، تمثل منحنى تطور الغليسيما عند شخص سليم. نلاحظ ارتفاعًا من 0.9 غ/ل إلى 1.6 غ/ل بعد 30 دقيقة ثم انخفاضًا إلى 0.9 غ/ل بعد 120 دقيقة.', 'closed');
+  check('P1 1 accroc (sans conclusion) → ICM 75 · stade 3', p1.icm === 75 && p1.nextPedagogicalStage === 3, `ICM=${p1.icm} stade=${p1.nextPedagogicalStage}`);
+
+  const p2 = evalCase('verb_analyse_v1',
+    'تمثل الوثيقة 1 منحنى الغليسيما. نلاحظ ارتفاعًا من 0.9 إلى 1.6 بعد 30 دقيقة ثم انخفاضًا إلى 0.9 بعد 120 دقيقة.', 'closed');
+  check('P2 valeurs nues (0.9/1.6 sans unité) → ICM 50 · stade 2', p2.icm === 50 && p2.nextPedagogicalStage === 2, `ICM=${p2.icm} stade=${p2.nextPedagogicalStage}`);
+
+  const p3 = evaluateStudentProduction('verb_analyse_v1',
+    'نلاحظ أن الغليسيما ترتفع من 0.9 غ/ل إلى 1.6 غ/ل لأنّ الأنسولين يفرز ثم يخزنها الكبد.',
+    undefined, 3, { switchChoice: 'open', switchTruth: 'closed' });
+  check('P3 مفتاح faux + لأنّ + sans سند → ICM 25 · stade 2', p3.icm === 25 && p3.nextPedagogicalStage === 2, `ICM=${p3.icm} stade=${p3.nextPedagogicalStage} erreurs=[${p3.detectedErrors.map(e => e.tag).join(',')}]`);
+
+  const p4 = evalCase('verb_schematic_v1',
+    'أرسم البنيات بمربعات بسيطة: الخلية، النواة، الريبوزوم. أسمي كل بنية بسهم أفقي. أضع مفتاح الأرقام أسفل الرسم وعنوانًا شاملا: تأثير الدواء.', 'closed');
+  check('P4 رسم sans ترقيم الظواهر → ICM 60 pondéré (75 non pondéré)', p4.icm === 60, `ICM=${p4.icm} stade=${p4.nextPedagogicalStage}`);
+
+  const p5 = evalCase('verb_composer_v1',
+    'مقدمة: ما العلاقة بين الدواء والريبوزوم؟ نلاحظ في الوثيقة 1 أن البروتين يقل مع الدواء. الخلاصة: الدواء يثبط الترجمة.', 'open');
+  check('P5 texte sans mécanisme détaillé → ICM 60 pondéré', p5.icm === 60, `ICM=${p5.icm} stade=${p5.nextPedagogicalStage}`);
+
+  const p6 = evaluateStudentProduction('verb_analyse_v1', 'تتغير الغليسيما.', undefined, 3, { switchChoice: 'open', switchTruth: 'closed' });
+  check('P6 réponse quasi vide → ICM ≤25 · stade 2', p6.icm <= 25 && p6.nextPedagogicalStage === 2, `ICM=${p6.icm} stade=${p6.nextPedagogicalStage}`);
+
+  const p95 = evalCase('verb_explain_v1',
+    'انطلاقًا من الوثيقة 1، منحنى الغليسيما. نلاحظ ارتفاعًا من 0.9 غ/ل إلى 1.6 غ/ل بعد 30 دقيقة ثم عودة إلى 0.9 غ/ل. وهذا لأنّ الأنسولين يخزن الغلوكوز. الاستنتاج: البنكرياس ينظم الغليسيما.', 'open');
+  check('seuil ≥90 → stade 4', p95.icm >= 90 && p95.nextPedagogicalStage === 4, `ICM=${p95.icm} stade=${p95.nextPedagogicalStage}`);
+}
+
+// ─────────────────────────────────────────────
+// SECTION C — les 20 vraies règles de critères (plus de fallback « longueur »)
+// ─────────────────────────────────────────────
+console.log('── SECTION C : 20 vraies règles de critères ──');
+function critPasses(v: string, text: string, sw: 'open' | 'closed', cid: string, expected = true): void {
+  const rep = evalCase(v, text, sw);
+  const c = rep.criteriaResults.find(x => x.criterionId === cid);
+  check(`[${cid}] ${v} → ${expected ? 'passe' : 'échoue'}`, !!c && c.passed === expected, c ? (c.passed ? 'passé' : 'échoué') : `critère ${cid} absent`);
+}
+
+// comparaison : critères communs + similitudes ET différences
+critPasses('verb_compare_v1',
+  'تمثل الوثيقة جدولين عن النشاط الإنزيمي. أوجه التشابه: يتشابهان في درجة الحرارة المثلى. أوجه الاختلاف: في حين يختلفان في الرقم الهيدروجيني الأمثل، وفي المقابل لا يختلفان في التركيز. ومنه نستنتج أن الرقم الهيدروجيني يلعب دورا في النشاط الإنزيمي.', 'closed', 'comp_c2');
+// نقد : objet, positif+document, négatif/limites, jugement
+critPasses('verb_critique_v1',
+  'أنتقد نموذج الدواء كعامل وحيد: من الإيجابيات أنه يقلل الأعراض حسب الوثيقة 2، لكن من السلبيات أنه لا يعالج السبب، كما أن له حدودا في الجرعات. في رأيي يجب دمجه مع تنظيم الحياة اليومية.', 'open', 'cr_c1');
+critPasses('verb_critique_v1',
+  'أنتقد نموذج الدواء كعامل وحيد: من الإيجابيات أنه يقلل الأعراض حسب الوثيقة 2، لكن من السلبيات أنه لا يعالج السبب، كما أن له حدودا في الجرعات. في رأيي يجب دمجه مع تنظيم الحياة اليومية.', 'open', 'cr_c2');
+critPasses('verb_critique_v1',
+  'أنتقد نموذج الدواء كعامل وحيد: من الإيجابيات أنه يقلل الأعراض حسب الوثيقة 2، لكن من السلبيات أنه لا يعالج السبب، كما أن له حدودا في الجرعات. في رأيي يجب دمجه مع تنظيم الحياة اليومية.', 'open', 'cr_c3');
+critPasses('verb_critique_v1',
+  'أنتقد نموذج الدواء كعامل وحيد: من الإيجابيات أنه يقلل الأعراض حسب الوثيقة 2، لكن من السلبيات أنه لا يعالج السبب، كما أن له حدودا في الجرعات. في رأيي يجب دمجه مع تنظيم الحياة اليومية.', 'open', 'cr_c4');
+// استنتاج : aucun chiffre répété après « الاستنتاج »
+critPasses('verb_deduce_v1',
+  'انطلاقا من الوثيقة 1 نلاحظ تطور الغليسيما عند شخص سليم. الاستنتاج: ارتفاع الغليسيما بعد الوجبة يحرر الأنسولين الذي يخزن الغلوكوز في الكبد.', 'closed', 'ded_c2');
+critPasses('verb_deduce_v1',
+  'انطلاقا من الوثيقة 1 نلاحظ تطور الغليسيما. الاستنتاج: تبلغ قيمة الغليسيما 1.6 غ/ل بعد 30 دقيقة.', 'closed', 'ded_c2', false);
+// اشرح multi-documents
+critPasses('verb_explain_multi_v1',
+  'تمثل الوثيقة 1 منحنى الغليسيما: نلاحظ ارتفاعا ثم عودة إلى 0.9 غ/ل. وتمثل الوثيقة 2 تطور الغليكوجين: نلاحظ ارتفاعه بعد الوجبة. وهذا لأن الأنسولين يحفز الخزن. نستنتج أن الكبد ينظم الغليسيما.', 'open', 'exp_m_c1');
+critPasses('verb_explain_multi_v1',
+  'تمثل الوثيقة 1 منحنى الغليسيما: نلاحظ ارتفاعا ثم عودة إلى 0.9 غ/ل. وتمثل الوثيقة 2 تطور الغليكوجين: نلاحظ ارتفاعه بعد الوجبة. وهذا لأن الأنسولين يحفز الخزن. نستنتج أن الكبد ينظم الغليسيما.', 'open', 'exp_m_c2');
+// فرضية : départ expérimental + problème
+critPasses('verb_hypothesis_v1',
+  'نلاحظ في التجربة أن الخلايا المعالجة بالدواء تتوقف عن الترجمات. المشكل العلمي: كيف يعمل الدواء على الخلية؟ الفرضية: يثبط الدواء عمل الريبوزومات.', 'open', 'hyp_c1');
