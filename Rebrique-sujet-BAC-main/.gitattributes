# Enforce LF line endings for all text files so format:check / prettier
# behave identically across Linux, macOS and Windows.
* text=auto eol=lf

# Binary assets must never be touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Large generated/patch artefacts: keep as-is.
*.patch -text
