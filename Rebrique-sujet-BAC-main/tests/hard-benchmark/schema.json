{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardBenchmarkCase",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "year",
          "sujet",
          "exercise",
          "pole",
          "category",
          "answer",
          "source",
          "collector",
          "auditId",
          "annotations",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}(?:-[a-z]{1,3})?-S\\d+-E\\d+-[NSEW]-\\d{3}$"
          },
          "year": {
            "type": "string",
            "pattern": "^\\d{4}(?:-[a-z]{1,3})?$"
          },
          "sujet": {
            "type": "integer",
            "minimum": 1
          },
          "exercise": {
            "type": "integer",
            "minimum": 1
          },
          "pole": {
            "type": "string",
            "enum": ["N", "S", "E", "W"]
          },
          "category": {
            "type": "string",
            "enum": ["strong", "weak", "scientifically-wrong", "off-topic"]
          },
          "answer": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "collector": {
            "type": "string",
            "minLength": 1
          },
          "annotations": {
            "type": "array",
            "minItems": 2,
            "description": "Deux annotations indépendantes de correcteurs humains, avant arbitrage éventuel.",
            "items": {
              "type": "object",
              "required": ["annotator", "score", "note", "completedAt", "blindedToPeer", "blindedToEngine"],
              "properties": {
                "annotator": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "completedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "blindedToPeer": {
                  "const": true
                },
                "blindedToEngine": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          },
          "adjudication": {
            "type": "object",
            "description": "Facultatif : décision d'un troisième correcteur si les deux notes divergent.",
            "required": ["annotator", "score", "note"],
            "properties": {
              "annotator": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "auditId": {
            "type": "string",
            "pattern": "^AUD-[A-Z0-9-]{8,}$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
