+
+export default function TeacherDashboard({ onClose }: { onClose: () => void }) {
+  const [rows, setRows] = useState<TeacherStudentRow[] | null>(null);
+  const [error, setError] = useState('');
+  const [expanded, setExpanded] = useState<string | null>(null);
+  const [detail, setDetail] = useState<{ entries: ProductionLogEntry[]; loading: boolean }>({ entries: [], loading: false });
+
+  const load = async () => {
+    setError('');
