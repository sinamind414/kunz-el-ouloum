+# BOUSSOLE — exécution du suivi élèves (comptes + synchro + tableau de bord)
+# Build : docker build -t boussole .
+# Run   : docker run -p 3000:3000 -e ADMIN_EMAIL=... -e ADMIN_PASSWORD=... \
+#          -v boussole-data:/app/data boussole
+FROM node:20-alpine
+WORKDIR /app
+COPY package*.json ./
+RUN npm install --no-audit --no-fund
+COPY . .
+RUN npm run build
+ENV NODE_ENV=production
+ENV PORT=3000
+ENV KUNZ_DB_FILE=data/students.json
+EXPOSE 3000
+CMD ["npm", "start"]
