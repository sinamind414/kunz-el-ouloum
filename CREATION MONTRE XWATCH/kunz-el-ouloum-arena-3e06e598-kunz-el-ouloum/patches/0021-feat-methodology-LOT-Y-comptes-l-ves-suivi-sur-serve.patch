+          {isRegister && <p className="text-[10px] text-gray-400 mt-1">8 أحرف على الأقل — تُحفظ مشفّرة على الخادم.</p>}
+        </div>
+
+        {isRegister && (
+          <div>
+            <label className="text-xs font-black text-gray-600 dark:text-gray-300 block mb-1">تأكيد كلمة السر</label>
+            <input value={props.confirm} onChange={e => props.setConfirm(e.target.value)} type={props.showPwd ? 'text' : 'password'} dir="ltr" placeholder="••••••••"
+              className="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2.5 text-sm font-bold text-gray-900 dark:text-white text-left outline-none focus:ring-2 focus:ring-emerald-500" />
+          </div>
+        )}
+
+        {isRegister && (
+          <label className="flex items-start gap-2.5 cursor-pointer bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-xl p-3">
+            <input type="checkbox" checked={props.accepted} onChange={e => props.setAccepted(e.target.checked)} className="mt-0.5" />
+            <span className="text-[11px] leading-relaxed text-gray-600 dark:text-gray-300 font-medium">
+              أوافق على تسجيل بياناتي (الإنتاجات، العلامات المنهجية، الأخطاء، الزمن) على خادم الأستاذ بغرض
+              متابعة تقدمي الدراسي — طبقًا للقانون 18-07 المتعلق بحماية المعطيات ذات الطابع الشخصي، ويمكنني
+              طلب الاطلاع أو الحذف في أي وقت.
+            </span>
+          </label>
+        )}
+
+        {props.error && <p className="text-xs font-black text-rose-600 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl px-3 py-2">{props.error}</p>}
+
+        <button onClick={() => props.setShowAdvanced(!props.showAdvanced)} className="text-[11px] font-black text-gray-400 hover:text-gray-600 flex items-center gap-1">
+          <ChevronDown className={`w-3.5 h-3.5 ${props.showAdvanced ? 'rotate-180' : ''}`} /> إعدادات متقدمة (عنوان الخادم)
+        </button>
+        {props.showAdvanced && (
+          <div>
+            <label className="text-xs font-black text-gray-600 dark:text-gray-300 block mb-1">عنوان خادم المزامنة</label>
+            <input value={props.serverUrl} onChange={e => { props.setServerUrl(e.target.value); setServerUrl(e.target.value); }} dir="ltr" placeholder="https://mon-serveur.dz"
+              className="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2.5 text-xs font-bold text-gray-900 dark:text-white text-left outline-none focus:ring-2 focus:ring-emerald-500" />
+            <p className="text-[10px] text-gray-400 mt-1">فارغ = نفس عنوان الموقع. املأه فقط إذا كان الخادم منفصلًا.</p>
