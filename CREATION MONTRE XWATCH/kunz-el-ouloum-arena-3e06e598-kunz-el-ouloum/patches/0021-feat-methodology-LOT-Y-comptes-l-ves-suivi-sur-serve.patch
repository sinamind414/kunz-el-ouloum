+// ============================================================
+// createTeacher.ts — créer/mettre à jour le compte enseignant
+// Usage : npm run teacher -- <email> <motDePasse> [Nom]
+// (ou définir ADMIN_EMAIL / ADMIN_PASSWORD avant le premier lancement)
+// ============================================================
+import path from 'node:path';
+import { JsonStore } from './store';
+import { isValidEmail, passwordIssue } from './authCore';
+
+const [email, password, ...nameParts] = process.argv.slice(2);
+const name = nameParts.join(' ') || 'المعلّم';
+
+if (!email || !password) {
+  console.error('Usage : npm run teacher -- <email> <motDePasse> [Nom]');
+  process.exit(1);
+}
+if (!isValidEmail(email)) {
+  console.error('✗ Email invalide :', email);
+  process.exit(1);
+}
+if (passwordIssue(password)) {
+  console.error('✗ Mot de passe trop court (8 caractères minimum).');
+  process.exit(1);
+}
+
+const file = process.env.KUNZ_DB_FILE || path.join('data', 'students.json');
+const store = new JsonStore(file);
+const existing = store.findUserByEmail(email);
+
+if (existing) {
+  store.promoteToTeacher(existing.email);
+  console.log(`⚠️  ${email} existait déjà → promu enseignant (rôle teacher).`);
+} else {
+  store.createUser(email, name, password, 'teacher');
+  console.log(`✅ Compte enseignant créé : ${email} (rôle teacher).`);
+}
+console.log(`📦 Base de données : ${file}`);
diff --git a/server/store.ts b/server/store.ts
new file mode 100644
index 0000000..49d6d6c
--- /dev/null
+++ b/server/store.ts
@@ -0,0 +1,199 @@
+// ============================================================
+// store.ts — persistance serveur (fichier JSON, écriture atomique)
+// École/classe : quelques centaines d'élèves → un fichier JSON
+// suffit (sauvegardez-le régulièrement). Passage à SQLite/Postgres
+// possible plus tard : l'API expose déjà un contrat stable.
+// ============================================================
+import fs from 'node:fs';
+import path from 'node:path';
+import { hashPassword, newId, normalizeEmail, verifyPassword } from './authCore';
+
+export interface StoredUser {
+  id: string;
+  role: 'student' | 'teacher';
+  email: string;
+  name: string;
+  passwordHash: string;
+  salt: string;
+  createdAt: string;
+}
+
+export interface StoredSession {
+  tokenHash: string;
+  userId: string;
+  expiresAt: string;
+}
+
+interface DbShape {
+  users: StoredUser[];
+  sessions: StoredSession[];
+  productions: { studentId: string; entry: Record<string, unknown>; syncedAt: string }[];
+}
+
+const EMPTY_DB: DbShape = { users: [], sessions: [], productions: [] };
+const SESSION_TTL_MS = 7 * 24 * 3600 * 1000; // 7 jours
+
+export class JsonStore {
+  private data: DbShape;
+  private file: string;
+
+  constructor(filePath: string) {
+    this.file = filePath;
+    this.data = this.load();
+  }
+
+  private load(): DbShape {
+    try {
+      if (fs.existsSync(this.file)) {
+        const parsed = JSON.parse(fs.readFileSync(this.file, 'utf8')) as Partial<DbShape>;
+        return {
+          users: Array.isArray(parsed.users) ? parsed.users : [],
+          sessions: Array.isArray(parsed.sessions) ? parsed.sessions : [],
+          productions: Array.isArray(parsed.productions) ? parsed.productions : [],
+        };
+      }
+    } catch (e) {
+      console.warn(`[store] Lecture impossible de ${this.file} — départ à vide :`, e);
+    }
+    return { ...EMPTY_DB, users: [], sessions: [], productions: [] };
+  }
+
+  private save(): void {
+    const dir = path.dirname(this.file);
+    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
+    const tmp = this.file + '.tmp';
+    fs.writeFileSync(tmp, JSON.stringify(this.data, null, 0), 'utf8');
+    fs.renameSync(tmp, this.file); // atomique
+  }
+
+  // ── Utilisateurs ──────────────────────────────────────────
+  findUserByEmail(email: string): StoredUser | undefined {
+    const e = normalizeEmail(email);
+    return this.data.users.find(u => u.email === e);
+  }
+
+  createUser(email: string, name: string, password: string, role: 'student' | 'teacher'): StoredUser {
+    const { hash, salt } = hashPassword(password);
+    const user: StoredUser = {
+      id: newId(),
+      role,
+      email: normalizeEmail(email),
+      name: name.trim(),
+      passwordHash: hash,
+      salt,
+      createdAt: new Date().toISOString(),
+    };
+    this.data.users.push(user);
+    this.save();
+    return user;
+  }
+
+  verifyCredentials(email: string, password: string): StoredUser | null {
+    const user = this.findUserByEmail(email);
+    if (!user) return null;
+    return verifyPassword(password, user.salt, user.passwordHash) ? user : null;
+  }
+
+  promoteToTeacher(email: string): StoredUser | null {
+    const user = this.findUserByEmail(email);
+    if (!user) return null;
+    user.role = 'teacher';
+    this.save();
+    return user;
+  }
+
+  /** Crée le compte enseignant au premier démarrage (env ADMIN_EMAIL / ADMIN_PASSWORD). */
+  ensureTeacherSeeded(adminEmail?: string, adminPassword?: string): void {
+    if (!adminEmail || !adminPassword) return;
+    if (this.data.users.some(u => u.role === 'teacher')) return;
+    const existing = this.findUserByEmail(adminEmail);
+    if (existing) {
+      existing.role = 'teacher';
+      this.save();
+      console.log(`[teacher] ${adminEmail} promu enseignant (role teacher).`);
+    } else {
+      this.createUser(adminEmail, 'المعلّم', adminPassword, 'teacher');
+      console.log(`[teacher] Compte enseignant créé : ${adminEmail}.`);
+    }
+  }
+
+  // ── Sessions ──────────────────────────────────────────────
+  createSession(userId: string, tokenHash: string): void {
+    this.data.sessions.push({
+      tokenHash,
+      userId,
+      expiresAt: new Date(Date.now() + SESSION_TTL_MS).toISOString(),
+    });
+    this.pruneSessions();
+    this.save();
+  }
+
+  getUserBySession(tokenHash: string): StoredUser | null {
+    const s = this.data.sessions.find(x => x.tokenHash === tokenHash);
+    if (!s) return null;
+    if (new Date(s.expiresAt).getTime() < Date.now()) {
+      this.data.sessions = this.data.sessions.filter(x => x.tokenHash !== tokenHash);
+      this.save();
+      return null;
+    }
+    return this.data.users.find(u => u.id === s.userId) || null;
+  }
+
+  deleteSession(tokenHash: string): void {
+    this.data.sessions = this.data.sessions.filter(x => x.tokenHash !== tokenHash);
+    this.save();
+  }
+
+  private pruneSessions(): void {
+    const now = Date.now();
+    this.data.sessions = this.data.sessions.filter(x => new Date(x.expiresAt).getTime() > now);
+  }
+
+  // ── Productions (carnet synchronisé) ─────────────────────
+  /** Upsert par (studentId, entry.id) → idempotent, re-sync sans doublons. */
+  addProduction(studentId: string, entry: Record<string, unknown>): void {
+    const id = String(entry.id ?? '');
+    if (!id) return;
+    const idx = this.data.productions.findIndex(p => p.studentId === studentId && String(p.entry.id) === id);
+    const record = { studentId, entry, syncedAt: new Date().toISOString() };
+    if (idx >= 0) this.data.productions[idx] = record;
+    else this.data.productions.push(record);
+    this.save();
+  }
+
+  getProductions(studentId: string): Record<string, unknown>[] {
+    return this.data.productions
+      .filter(p => p.studentId === studentId)
+      .map(p => p.entry)
+      .sort((a, b) => String(a.dateISO ?? '').localeCompare(String(b.dateISO ?? '')));
+  }
+
+  // ── Tableau de bord enseignant ────────────────────────────
+  teacherStudents(): { id: string; email: string; name: string; count: number; avgIcm: number; lastDate: string; topErrors: { tag: string; count: number }[]; stages: Record<string, number> }[] {
+    const students = this.data.users.filter(u => u.role === 'student');
+    return students.map(s => {
+      const entries = this.data.productions.filter(p => p.studentId === s.id);
+      const icms = entries.map(p => Number((p.entry as { icm?: number }).icm ?? NaN)).filter(n => !Number.isNaN(n));
+      const errorCounts = new Map<string, number>();
+      const stages: Record<string, number> = {};
+      for (const p of entries) {
+        const e = p.entry as { errorTags?: string[]; stage?: number; dateISO?: string };
+        for (const t of e.errorTags ?? []) errorCounts.set(t, (errorCounts.get(t) ?? 0) + 1);
+        const st = String(e.stage ?? '');
+        if (st) stages[st] = (stages[st] ?? 0) + 1;
+      }
+      const topErrors = [...errorCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([tag, count]) => ({ tag, count }));
+      const lastDate = entries.length ? String((entries[entries.length - 1].entry as { dateISO?: string }).dateISO ?? '') : '';
+      return {
+        id: s.id,
+        email: s.email,
+        name: s.name,
+        count: entries.length,
+        avgIcm: icms.length ? Math.round(icms.reduce((a, b) => a + b, 0) / icms.length) : 0,
+        lastDate,
+        topErrors,
+        stages,
+      };
+    }).sort((a, b) => b.lastDate.localeCompare(a.lastDate));
+  }
+}
