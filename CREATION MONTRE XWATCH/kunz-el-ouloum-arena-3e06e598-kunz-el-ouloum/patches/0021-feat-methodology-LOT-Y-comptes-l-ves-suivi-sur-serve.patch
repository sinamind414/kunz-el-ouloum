new file mode 100644
index 0000000..ad216c4
--- /dev/null
+++ b/src/utils/studentAccount.ts
@@ -0,0 +1,205 @@
+// ============================================================
+// studentAccount.ts — compte élève + synchronisation du carnet
+// Local-first : l'app fonctionne SANS serveur (le carnet reste
+// dans le navigateur) ; quand un compte est connecté, chaque
+// production est mise en file puis envoyée au serveur du prof.
+// ============================================================
+import type { ProductionLogEntry } from './methodologyLog';
+
+export interface AccountInfo {
+  token: string;
+  email: string;
+  name: string;
+  role: 'student' | 'teacher';
+}
+
+export type SyncStatus = 'off' | 'synced' | 'pending' | 'offline' | 'unauthorized' | 'error';
+
+const ACCOUNT_KEY = 'kunz_student_account_v1';
+const QUEUE_KEY = 'kunz_sync_queue_v1';
+const SERVER_KEY = 'kunz_sync_server_v1';
+
+export function getServerUrl(): string {
+  try {
+    const custom = localStorage.getItem(SERVER_KEY) || '';
+    return custom.replace(/\/+$/, '');
+  } catch {
+    return '';
+  }
+}
+
+export function setServerUrl(url: string): void {
+  try {
+    localStorage.setItem(SERVER_KEY, url.trim());
+  } catch { /* ignore */ }
+}
+
+export function getAccount(): AccountInfo | null {
+  try {
+    const raw = localStorage.getItem(ACCOUNT_KEY);
+    if (!raw) return null;
+    const a = JSON.parse(raw) as AccountInfo;
+    return a && a.token ? a : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveAccount(account: AccountInfo): void {
+  try {
+    localStorage.setItem(ACCOUNT_KEY, JSON.stringify(account));
+  } catch { /* ignore */ }
+}
+
+export function clearAccount(): void {
+  try {
+    localStorage.removeItem(ACCOUNT_KEY);
+  } catch { /* ignore */ }
+}
+
+function readQueue(): ProductionLogEntry[] {
+  try {
+    const raw = localStorage.getItem(QUEUE_KEY);
+    const arr = raw ? (JSON.parse(raw) as ProductionLogEntry[]) : [];
+    return Array.isArray(arr) ? arr : [];
+  } catch {
+    return [];
+  }
+}
+
+function writeQueue(q: ProductionLogEntry[]): void {
+  try {
+    localStorage.setItem(QUEUE_KEY, JSON.stringify(q));
+  } catch { /* ignore */ }
+}
+
+async function api(path: string, options: RequestInit = {}): Promise<{ ok: boolean; status: number; data: any }> {
+  const account = getAccount();
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    ...(options.headers as Record<string, string> | undefined),
+  };
+  if (account) headers['Authorization'] = `Bearer ${account.token}`;
+  const res = await fetch(getServerUrl() + path, { ...options, headers });
+  let data: any = null;
+  try {
+    data = await res.json();
+  } catch { /* corps non JSON */ }
+  return { ok: res.ok, status: res.status, data };
+}
+
+// ── AUTH ────────────────────────────────────────────────────
+export async function apiRegister(email: string, name: string, password: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const r = await api('/api/auth/register', { method: 'POST', body: JSON.stringify({ email, name, password }) });
+    if (r.ok && r.data?.token) {
+      saveAccount({ token: r.data.token, email: r.data.user.email, name: r.data.user.name, role: r.data.user.role });
+      return { ok: true };
+    }
+    return { ok: false, error: r.data?.error || 'bad_request' };
+  } catch {
+    return { ok: false, error: 'offline' };
+  }
+}
+
+export async function apiLogin(email: string, password: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const r = await api('/api/auth/login', { method: 'POST', body: JSON.stringify({ email, password }) });
+    if (r.ok && r.data?.token) {
+      saveAccount({ token: r.data.token, email: r.data.user.email, name: r.data.user.name, role: r.data.user.role });
+      return { ok: true };
+    }
+    return { ok: false, error: r.data?.error || 'invalid_credentials' };
+  } catch {
+    return { ok: false, error: 'offline' };
+  }
+}
+
+export async function apiLogout(): Promise<void> {
+  try {
+    await api('/api/auth/logout', { method: 'POST' });
+  } catch { /* le jeton expire seul */ }
+  clearAccount();
+}
+
+// ── SYNCHRO DU CARNET ───────────────────────────────────────
+export function enqueueProductionForSync(entry: ProductionLogEntry): void {
+  const account = getAccount();
+  if (!account || !entry?.id) return;
+  const q = readQueue();
+  if (q.some(e => e.id === entry.id)) return;
+  q.push(entry);
+  writeQueue(q);
+  void flushSyncQueue();
+}
+
+export function syncQueueLength(): number {
+  return readQueue().length;
+}
+
+export async function flushSyncQueue(): Promise<SyncStatus> {
+  const account = getAccount();
+  if (!account) return 'off';
+  const q = readQueue();
+  if (q.length === 0) return 'synced';
+  try {
+    const r = await api('/api/student/sync', { method: 'POST', body: JSON.stringify({ entries: q.slice(0, 100) }) });
+    if (r.ok) {
+      writeQueue(q.slice(100));
+      return q.length > 100 ? 'pending' : 'synced';
+    }
+    if (r.status === 401) {
+      clearAccount();
+      return 'unauthorized';
+    }
+    return 'error';
+  } catch {
+    return 'offline';
+  }
+}
+
+/** Restaure (fusionne) les entrées du serveur dans le carnet local. */
+export async function pullServerEntries(): Promise<{ added: number; total: number; error?: string }> {
+  try {
+    const r = await api('/api/student/entries');
+    if (!r.ok) return { added: 0, total: 0, error: r.data?.error || 'bad_request' };
+    const { importEntries } = await import('./methodologyLog');
+    const entries = (r.data?.entries || []) as ProductionLogEntry[];
+    const added = importEntries(entries);
+    return { added, total: entries.length };
+  } catch {
+    return { added: 0, total: 0, error: 'offline' };
+  }
+}
+
+// ── ENSEIGNANT ──────────────────────────────────────────────
+export interface TeacherStudentRow {
+  id: string;
+  email: string;
+  name: string;
+  count: number;
+  avgIcm: number;
+  lastDate: string;
+  topErrors: { tag: string; count: number }[];
+  stages: Record<string, number>;
+}
+
+export async function fetchTeacherDashboard(): Promise<{ students: TeacherStudentRow[]; error?: string }> {
+  try {
+    const r = await api('/api/teacher/dashboard');
+    if (!r.ok) return { students: [], error: r.data?.error || (r.status === 403 ? 'forbidden' : 'bad_request') };
+    return { students: (r.data?.students || []) as TeacherStudentRow[] };
+  } catch {
+    return { students: [], error: 'offline' };
+  }
+}
+
+export async function fetchTeacherEntries(studentId: string): Promise<{ entries: ProductionLogEntry[]; error?: string }> {
+  try {
+    const r = await api(`/api/teacher/entries?studentId=${encodeURIComponent(studentId)}`);
+    if (!r.ok) return { entries: [], error: r.data?.error || 'bad_request' };
+    return { entries: (r.data?.entries || []) as ProductionLogEntry[] };
+  } catch {
+    return { entries: [], error: 'offline' };
+  }
+}
