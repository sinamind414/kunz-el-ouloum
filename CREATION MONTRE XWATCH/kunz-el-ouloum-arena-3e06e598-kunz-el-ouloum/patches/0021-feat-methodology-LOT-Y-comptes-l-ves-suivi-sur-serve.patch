index 0000000..e4d4e9f
--- /dev/null
+++ b/server/api.ts
@@ -0,0 +1,136 @@
+// ============================================================
+// api.ts — routes REST du suivi élèves (comptes + synchro + prof)
+// Contrat : {error: <code>} en cas d'échec (l'UI traduit en arabe).
+// Sécurité : mots de passe hachés (scrypt) · jetons hachés ·
+//            limite de tentatives · rôle teacher vérifié côté serveur.
+// ============================================================
+import type { Request, Response, Express } from 'express';
+import { JsonStore, StoredUser } from './store';
+import { hashToken, isValidEmail, newSessionToken, normalizeEmail, passwordIssue } from './authCore';
+
+const MAX_SYNC_BATCH = 100;
+const RATE_WINDOW_MS = 15 * 60 * 1000;
+const RATE_MAX = 15;
+
+function rateLimiter() {
+  const hits = new Map<string, number[]>();
+  return (req: Request, res: Response, next: () => void) => {
+    const ip = req.ip || 'unknown';
+    const now = Date.now();
+    const arr = (hits.get(ip) || []).filter(t => now - t < RATE_WINDOW_MS);
+    if (arr.length >= RATE_MAX) {
+      res.status(429).json({ error: 'too_many_attempts' });
+      return;
+    }
+    arr.push(now);
+    hits.set(ip, arr);
+    next();
+  };
+}
+
+export function registerApi(app: Express, store: JsonStore): void {
+  // CORS (déploiement app + API sur des origines différentes).
+  app.use((req, res, next) => {
+    res.setHeader('Access-Control-Allow-Origin', req.headers.origin || '*');
+    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');
+    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+    if (req.method === 'OPTIONS') return res.sendStatus(204);
+    next();
+  });
+
+  const auth = (req: Request, res: Response, next: () => void) => {
+    const header = req.headers.authorization || '';
+    const token = header.startsWith('Bearer ') ? header.slice(7) : '';
+    if (!token) {
+      res.status(401).json({ error: 'unauthorized' });
+      return;
+    }
+    const user = store.getUserBySession(hashToken(token));
+    if (!user) {
+      res.status(401).json({ error: 'unauthorized' });
+      return;
+    }
+    (req as Request & { user?: StoredUser }).user = user;
+    next();
+  };
+
+  const requireTeacher = (req: Request, res: Response, next: () => void) => {
+    const user = (req as Request & { user?: StoredUser }).user;
+    if (!user || user.role !== 'teacher') {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    next();
+  };
+
+  const safeUser = (u: StoredUser) => ({ id: u.id, role: u.role, email: u.email, name: u.name });
+
+  // ── AUTH ──────────────────────────────────────────────────
+  const issueSession = (res: Response, user: StoredUser) => {
+    const token = newSessionToken();
+    store.createSession(user.id, hashToken(token));
+    res.json({ token, user: safeUser(user) });
+  };
+
+  app.post('/api/auth/register', rateLimiter(), (req: Request, res: Response) => {
+    const { email, name = '', password } = (req.body || {}) as { email?: string; name?: string; password?: string };
+    if (!email || !password) return res.status(400).json({ error: 'bad_request' });
+    if (!isValidEmail(email)) return res.status(400).json({ error: 'invalid_email' });
+    const issue = passwordIssue(password);
+    if (issue) return res.status(400).json({ error: issue });
+    if (store.findUserByEmail(email)) return res.status(409).json({ error: 'email_taken' });
+    const user = store.createUser(email, name || email.split('@')[0], password, 'student');
+    issueSession(res, user);
+  });
+
+  const loginLimiter = rateLimiter();
+  app.post('/api/auth/login', loginLimiter, (req: Request, res: Response) => {
+    const { email, password } = (req.body || {}) as { email?: string; password?: string };
+    if (!email || !password) return res.status(400).json({ error: 'bad_request' });
+    const user = store.verifyCredentials(normalizeEmail(email), password);
+    if (!user) return res.status(401).json({ error: 'invalid_credentials' });
+    issueSession(res, user);
+  });
+
+  app.post('/api/auth/logout', auth, (req: Request, res: Response) => {
+    const token = (req.headers.authorization || '').slice(7);
+    store.deleteSession(hashToken(token));
+    res.json({ ok: true });
+  });
+
+  app.get('/api/auth/me', auth, (req: Request, res: Response) => {
+    res.json({ user: safeUser((req as Request & { user: StoredUser }).user) });
+  });
+
+  // ── SUIVI ÉLÈVE ───────────────────────────────────────────
+  app.post('/api/student/sync', auth, (req: Request, res: Response) => {
+    const user = (req as Request & { user: StoredUser }).user;
+    const entries = (req.body || {}).entries as Record<string, unknown>[] | undefined;
+    if (!Array.isArray(entries) || entries.length === 0) return res.status(400).json({ error: 'bad_request' });
+    const batch = entries.slice(0, MAX_SYNC_BATCH);
+    let synced = 0;
+    for (const e of batch) {
+      if (e && typeof e === 'object' && e.id) {
+        store.addProduction(user.id, e);
+        synced++;
+      }
+    }
+    res.json({ synced, total: store.getProductions(user.id).length });
+  });
+
+  app.get('/api/student/entries', auth, (req: Request, res: Response) => {
+    const user = (req as Request & { user: StoredUser }).user;
+    res.json({ entries: store.getProductions(user.id) });
+  });
+
+  // ── TABLEAU DE BORD ENSEIGNANT ────────────────────────────
+  app.get('/api/teacher/dashboard', auth, requireTeacher, (_req: Request, res: Response) => {
+    res.json({ students: store.teacherStudents() });
+  });
+
+  app.get('/api/teacher/entries', auth, requireTeacher, (req: Request, res: Response) => {
+    const studentId = String(req.query.studentId || '');
+    if (!studentId) return res.status(400).json({ error: 'bad_request' });
+    res.json({ entries: store.getProductions(studentId) });
+  });
+}
