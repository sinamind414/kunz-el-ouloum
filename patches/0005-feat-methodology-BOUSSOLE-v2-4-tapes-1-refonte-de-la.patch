@@ -0,0 +1,122 @@
+import React, { useEffect, useState, useRef } from 'react';
+import { KeyRound, Lock, Unlock, Timer } from 'lucide-react';
+import { SwitchState, SWITCH_QUESTION_AR, REGLE_D_OR_AR } from '../data/boussoleData';
+
+interface Props {
+  open: boolean;
+  verbAr: string;
+  /** null = l'élève n'a pas répondu (temps écoulé) — la correction le signalera */
+  onDecide: (choice: SwitchState | null) => void;
+}
+
+const GATE_SECONDS = 10;
+
+/**
+ * بوابة المفتاح : 10 secondes, une seule question avant d'écrire.
+ * « هل الفعل يسمح بـ«لأنّ» ؟ » — la seule décision méthodologique de l'épreuve.
+ * Le choix de l'élève est enregistré ; s'il se trompe, la correction le lui dit
+ * AVANT de compter les fautes de fond.
+ */
+export default function SwitchGateModal({ open, verbAr, onDecide }: Props) {
+  const [seconds, setSeconds] = useState(GATE_SECONDS);
+  const decidedRef = useRef(false);
+
+  useEffect(() => {
+    if (!open) {
+      setSeconds(GATE_SECONDS);
+      decidedRef.current = false;
+      return;
+    }
+    const id = setInterval(() => setSeconds(s => Math.max(0, s - 1)), 1000);
+    return () => clearInterval(id);
+  }, [open]);
+
+  // Temps écoulé sans réponse → on enregistre null (une seule fois)
+  useEffect(() => {
+    if (open && seconds === 0 && !decidedRef.current) {
+      decidedRef.current = true;
+      onDecide(null);
+    }
+  }, [open, seconds, onDecide]);
+
+  if (!open) return null;
+
+  const decide = (c: SwitchState) => {
+    if (decidedRef.current) return;
+    decidedRef.current = true;
+    onDecide(c);
+  };
+
+  const progress = ((GATE_SECONDS - seconds) / GATE_SECONDS) * 100;
