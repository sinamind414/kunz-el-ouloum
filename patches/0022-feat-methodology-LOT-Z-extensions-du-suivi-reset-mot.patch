+  // ── Événements d'activité (quiz, missions, drill) ────────
+  /** Upsert par (studentId, entry.id) → idempotent. */
+  addEvent(studentId: string, entry: Record<string, unknown>): void {
+    const id = String(entry.id ?? '');
+    if (!id) return;
+    const idx = this.data.events.findIndex(p => p.studentId === studentId && String(p.entry.id) === id);
+    const record = { studentId, entry, syncedAt: new Date().toISOString() };
+    if (idx >= 0) this.data.events[idx] = record;
+    else this.data.events.push(record);
+    this.save();
+  }
+
+  getEvents(studentId: string): Record<string, unknown>[] {
+    return this.data.events
+      .filter(p => p.studentId === studentId)
+      .map(p => p.entry)
+      .sort((a, b) => String(a.dateISO ?? '').localeCompare(String(b.dateISO ?? '')));
+  }
+
+  getEventsFor(studentId: string, kind: string): Record<string, unknown>[] {
+    return this.getEvents(studentId).filter(e => e.kind === kind);
+  }
+
+  // ── Réinitialisation de mot de passe (code à usage unique) ──
+  /** Crée un code (renvoyé EN CLAIR une seule fois ; stocké haché, TTL 30 min). */
+  createPasswordReset(userId: string): { code: string; expiresAt: string } {
+    // Un seul code actif par utilisateur à la fois.
+    this.data.resetRequests = this.data.resetRequests.filter(r => r.userId !== userId);
+    const code = crypto.randomBytes(4).toString('hex').toUpperCase(); // 8 caractères
+    const req = {
+      userId,
+      codeHash: crypto.createHash('sha256').update(code).digest('hex'),
+      expiresAt: new Date(Date.now() + RESET_TTL_MS).toISOString(),
+      createdAt: new Date().toISOString(),
+    };
+    this.data.resetRequests.push(req);
+    this.save();
+    return { code, expiresAt: req.expiresAt };
+  }
+
+  /** Vérifie le code et change le mot de passe. Usage unique + TTL 30 min. */
+  applyPasswordReset(email: string, code: string, newPassword: string): boolean {
+    const user = this.findUserByEmail(email);
+    if (!user) return false;
+    const codeHash = crypto.createHash('sha256').update(String(code).trim().toUpperCase()).digest('hex');
+    const idx = this.data.resetRequests.findIndex(r => r.userId === user.id && r.codeHash === codeHash);
+    if (idx < 0) return false;
+    if (new Date(this.data.resetRequests[idx].expiresAt).getTime() < Date.now()) {
+      this.data.resetRequests.splice(idx, 1);
+      this.save();
+      return false;
+    }
+    this.data.resetRequests.splice(idx, 1); // usage unique
+    const { hash, salt } = hashPassword(newPassword);
+    user.passwordHash = hash;
+    user.salt = salt;
+    // Toutes les sessions deviennent invalides (sécurité).
+    this.data.sessions = this.data.sessions.filter(s => s.userId !== user.id);
+    this.save();
+    return true;
+  }
