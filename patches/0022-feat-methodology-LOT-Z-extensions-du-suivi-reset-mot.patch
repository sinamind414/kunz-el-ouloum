--- /dev/null
+++ b/src/utils/activityLog.ts
@@ -0,0 +1,63 @@
+// ============================================================
+// activityLog.ts — journal d'activité (quiz, missions, drill)
+// Même principe local-first que le carnet de production : stocké
+// dans le navigateur, mis en file, envoyé au serveur si un compte
+// est connecté. L'app fonctionne sans serveur.
+// ============================================================
+import { enqueueEventForSync } from './studentAccount';
+
+export interface ActivityEventEntry {
+  id: string;
+  kind: 'quiz' | 'mission' | 'drill';
+  dateISO: string;
+  title?: string;       // ex: titre de l'unité
+  score?: number;       // bonnes réponses
+  total?: number;       // questions
+  percent?: number;     // score/total × 100
+  durationSec?: number;
+  domain?: number;
+  unitId?: string;
+}
+
+const STORAGE_KEY = 'kunz_activity_events_v1';
+const MAX_EVENTS = 200;
+
+function safeRead(): ActivityEventEntry[] {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    const arr = raw ? (JSON.parse(raw) as ActivityEventEntry[]) : [];
+    return Array.isArray(arr) ? arr : [];
+  } catch {
+    return [];
+  }
+}
+
+function write(all: ActivityEventEntry[]): void {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
+  } catch { /* ignore */ }
+}
+
+export function getActivityEvents(): ActivityEventEntry[] {
+  return safeRead().sort((a, b) => a.dateISO.localeCompare(b.dateISO));
+}
+
+/** Enregistre un événement et le met en file de synchro (si compte connecté). */
+export function logActivityEvent(entry: Omit<ActivityEventEntry, 'id' | 'dateISO'>): ActivityEventEntry | null {
+  try {
+    const full: ActivityEventEntry = {
+      ...entry,
+      id: `a_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
+      dateISO: new Date().toISOString(),
+    };
+    const all = safeRead();
+    all.push(full);
+    if (all.length > MAX_EVENTS) all.splice(0, all.length - MAX_EVENTS);
+    write(all);
+    enqueueEventForSync(full); // compte connecté → synchro serveur
+    return full;
+  } catch (e) {
+    console.warn('Impossible d’archiver l’activité:', e);
+    return null;
+  }
+}
