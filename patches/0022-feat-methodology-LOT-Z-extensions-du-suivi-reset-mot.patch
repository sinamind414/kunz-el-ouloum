+  }
+}
+
+// ── ENSEIGNANT : RESET + EXPORT ─────────────────────────────
+/** Enseignant : génère un code de réinitialisation pour un élève. */
+export async function apiTeacherResetPassword(studentId: string): Promise<{ ok: boolean; code?: string; error?: string }> {
+  try {
+    const r = await api('/api/teacher/reset-password', { method: 'POST', body: JSON.stringify({ studentId }) });
+    return r.ok ? { ok: true, code: r.data?.code } : { ok: false, error: r.data?.error || 'bad_request' };
+  } catch {
+    return { ok: false, error: 'offline' };
+  }
+}
+
+/** Enseignant : télécharge l'export CSV (tous les élèves, ou un seul). */
+export async function apiExportCsv(studentId?: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const account = getAccount();
+    if (!account) return { ok: false, error: 'unauthorized' };
+    const path = studentId ? `/api/teacher/export.csv?studentId=${encodeURIComponent(studentId)}` : '/api/teacher/export.csv';
+    const res = await fetch(getServerUrl() + path, { headers: { Authorization: `Bearer ${account.token}` } });
+    if (!res.ok) return { ok: false, error: 'bad_request' };
+    const blob = await res.blob();
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = studentId ? `boussole_eleve_${studentId.slice(0, 6)}.csv` : 'boussole_suivi_tous_eleves.csv';
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    URL.revokeObjectURL(url);
+    return { ok: true };
+  } catch {
+    return { ok: false, error: 'offline' };
+  }
+}
