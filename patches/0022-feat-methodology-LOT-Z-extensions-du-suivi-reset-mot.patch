+// ── RÉINITIALISATION DE MOT DE PASSE ───────────────────────
+/** Élève : applique le code reçu de l'enseignant + nouveau mot de passe. */
+export async function apiResetPassword(email: string, code: string, newPassword: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const r = await api('/api/auth/reset-password', { method: 'POST', body: JSON.stringify({ email, code, newPassword }) });
+    return r.ok ? { ok: true } : { ok: false, error: r.data?.error || 'bad_request' };
