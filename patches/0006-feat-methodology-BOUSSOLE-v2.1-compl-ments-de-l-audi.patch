@@ -0,0 +1,259 @@
+import React, { useMemo, useState, useEffect, useRef } from 'react';
+import { KeyRound, Lock, Unlock, Timer, RefreshCw, X, Zap, CheckCircle2, XCircle } from 'lucide-react';
+import { getSwitchForVerb, SWITCH_QUESTION_AR, switchPathAr, SwitchState } from '../data/boussoleData';
+import { VERB_CARDS } from '../data/methodologyEngine';
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  /** exercice proposé en remédiation : on peut ne drill que ce verbe */
+  focusVerbId?: string;
+}
+
+const DRILL_SECONDS = 60;
+
+function shuffle<T>(arr: T[]): T[] {
+  const a = [...arr];
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+const QUOTES: Record<string, string> = {
+  verb_analyse_v1: 'حَلِّلْ',
+  verb_explain_v1: 'فَسِّرْ',
+  verb_compare_v1: 'قَارِنْ',
+  verb_hypothesis_v1: 'اقْتَرِحْ فَرَضِيَّةً',
+  verb_deduce_v1: 'اسْتَنْتِجْ',
+  verb_validate_v1: 'صَادِقْ عَلَى الصِّحَّة',
+  verb_explain_multi_v1: 'اشْرَحْ',
+  verb_schema_v1: 'لَخِّصْ فِي مُخَطَّطْ',
+  verb_justify_v1: 'عَلِّلْ / بَرِّرْ',
+  verb_schematic_v1: 'أَنْجِزْ رَسْمًا تَخْطِيطِيًا وَظِيفِيًا',
+  verb_critique_v1: 'انْقُدْ',
+  verb_composer_v1: 'اكْتُبْ نَصًّا عِلْمِيًّا',
+};
+
+/**
+ * Micro-drill du مفتاح : 60 secondes, des verbes en rafale.
+ * Le réflexe à entraîner n'est pas de réciter la méthode — c'est de
+ * décider, en 2 secondes, si le verbe permet « لأنّ ».
+ */
+export default function SwitchDrillModal({ open, onClose, focusVerbId }: Props) {
+  const [started, setStarted] = useState(false);
+  const [index, setIndex] = useState(0);
+  const [answers, setAnswers] = useState<{ verbId: string; correct: boolean }[]>([]);
+  const [secondsLeft, setSecondsLeft] = useState(DRILL_SECONDS);
+  const [done, setDone] = useState(false);
+  const answeredRef = useRef(false);
+
+  // Sélection des verbes : 12 en rafale (ou 1 seul en remédiation)
+  const deck = useMemo(() => {
+    if (!open) return [];
+    const pool = focusVerbId
+      ? [focusVerbId]
+      : VERB_CARDS.map(v => v.id);
+    return shuffle(pool);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [open, focusVerbId]);
+
+  const reset = (restart = false) => {
+    setStarted(restart);
+    setIndex(0);
+    setAnswers([]);
+    setSecondsLeft(DRILL_SECONDS);
+    setDone(false);
+    answeredRef.current = false;
+  };
+
+  // Timer
+  useEffect(() => {
+    if (!open || !started || done) return;
+    const id = setInterval(() => setSecondsLeft(s => Math.max(0, s - 1)), 1000);
+    return () => clearInterval(id);
+  }, [open, started, done]);
+
+  // Fin automatique (temps écoulé)
+  useEffect(() => {
+    if (open && started && secondsLeft === 0 && !done) {
+      setDone(true);
+    }
+  }, [open, started, secondsLeft, done]);
+
+  if (!open) return null;
+
+  const total = deck.length;
+  const currentVerbId = deck[Math.min(index, total - 1)];
+  const truth = currentVerbId ? getSwitchForVerb(currentVerbId) : 'closed';
+  const answered = answeredRef.current;
+  const correctCount = answers.filter(a => a.correct).length;
+
+  const answer = (choice: SwitchState) => {
+    if (answered || done) return;
+    answeredRef.current = true;
+    setAnswers(prev => [...prev, { verbId: currentVerbId, correct: choice === truth }]);
+  };
+
+  const next = () => {
+    if (index + 1 >= total) {
+      setDone(true);
+    } else {
+      answeredRef.current = false;
+      setIndex(i => i + 1);
+    }
+  };
+
+  const scorePct = total ? Math.round((correctCount / total) * 100) : 0;
+
+  return (
