+++ b/src/components/QuarterTimerBar.tsx
@@ -0,0 +1,58 @@
+import React from 'react';
+import { Timer } from 'lucide-react';
+import { getStep } from '../data/boussoleData';
+
+interface Props {
+  timeLimit: number;   // secondes totales
+  timeLeft: number;    // secondes restantes
+}
+
+/**
+ * Barre de temps en quarts (audit v2 §5) :
+ *   الربع الأول (25 %) : اقرأ + اجمع  ·  النصف (50 %) : اربط / اكتب  ·  الربع الأخير (25 %) : اختم + الفحص
+ * Le dernier quart ne se négocie pas : c'est là que sont la conclusion et la relecture.
+ */
+export default function QuarterTimerBar({ timeLimit, timeLeft }: Props) {
+  const elapsed = Math.max(0, timeLimit - timeLeft);
+  const f = timeLimit > 0 ? elapsed / timeLimit : 0; // 0..1
+
+  const phases = [
+    { id: 1, label: '١ اقرأ + ٢ اجمع', color: getStep(1).color, from: 0, to: 0.25 },
+    { id: 2, label: '٣ اربط / اكتب', color: getStep(3).color, from: 0.25, to: 0.75 },
+    { id: 3, label: '٤ اختم + الفحص', color: getStep(4).color, from: 0.75, to: 1 },
+  ];
+
+  const current = phases.find(p => f >= p.from && f < p.to) || phases[phases.length - 1];
+
+  return (
+    <div className="space-y-1.5">
+      {/* Label phase courante */}
+      <div className="flex items-center justify-between gap-2">
+        <span className="flex items-center gap-1.5 text-[10px] font-black text-white/90">
+          <Timer className="w-3 h-3" />
+          <span>
+            أنت الآن في: <span style={{ color: current.color === '#7c3aed' ? '#c4b5fd' : '#fed65b' }}>{current.label}</span>
+          </span>
+        </span>
+        <span className="text-[9px] font-bold text-white/60">
+          الربع الأخير لا يُناقَش — فيه الخاتمة والفحص
+        </span>
+      </div>
+
+      {/* Barre segmentée */}
+      <div className="flex h-2.5 w-full rounded-full overflow-hidden bg-black/25" dir="rtl">
+        {phases.map(p => {
+          const segFrom = f < p.from ? 0 : f >= p.to ? 1 : (f - p.from) / (p.to - p.from);
+          return (
+            <div key={p.id} className="relative h-full" style={{ width: `${(p.to - p.from) * 100}%`, backgroundColor: p.id === current.id ? `${p.color}33` : 'rgba(255,255,255,0.06)' }}>
+              <div
+                className="absolute inset-y-0 right-0 rounded-full transition-all duration-500"
+                style={{ width: `${segFrom * 100}%`, backgroundColor: p.color, opacity: p.id === current.id ? 1 : 0.35 }}
+              />
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
