+      expect(carte!.deverrouApresUnites, `${c.tab} ne doit jamais être cadenassé`).toBeUndefined();
+    }
+    expect(new Set(etats.map(([e, u]) => consigneEntreeTraining(e, u)!.tab)).size).toBeGreaterThan(1);
