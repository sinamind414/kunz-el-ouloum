diff --git a/src/supervision/evaluerCopies.m3.test.ts b/src/supervision/evaluerCopies.m3.test.ts
new file mode 100644
index 0000000..6d8a74f
--- /dev/null
+++ b/src/supervision/evaluerCopies.m3.test.ts
@@ -0,0 +1,54 @@
+// Pré-vol M3 (2026-11-04) : le harnais doit accepter le lot tel que le
+// README le décrit (30 copies numérotées 101-130 + RECAPITULATIF).
+import { describe, expect, it } from 'vitest';
+import {
+  couperBlocScore,
+  evaluerBatch,
+  parserRecap,
+  parserScoreAttendu,
+} from './evaluerCopies';
+
+const copieComplete = () =>
+  [
+    'التمرين الأول réponse de l élève 1',
+    'التمرين الثاني réponse de l élève 2',
+    'التمرين الثالث réponse de l élève 3',
+  ].join('\n');
+
+describe('M3 — RECAPITULATIF et numérotation 101-130', () => {
+  it('30 lignes → 30 notes distinctes 101…130 (avant le fix : 4 clés 10/11/12/13)', () => {
+    const lignes = Array.from({ length: 30 }, (_, i) => `eleve_${101 + i} | ${(4 + (i % 13)).toFixed(1)}`).join('\n');
+    const r = parserRecap(lignes);
+    expect(r.notes.size).toBe(30);
+    expect([...r.notes.keys()].sort((a, b) => a - b)).toEqual(Array.from({ length: 30 }, (_, i) => 101 + i));
+    expect(r.notes.has(10)).toBe(false);
+  });
+
+  it('formats historiques (2 chiffres, virgule, tableau) : non-régression', () => {
+    const r = parserRecap('eleve_01 : 12.5\neleve_02 13,5/20\n03 | 9');
+    expect(r.notes.get(1)).toBe(12.5);
+    expect(r.notes.get(2)).toBe(13.5);
+    expect(r.notes.get(3)).toBe(9);
+  });
+
+  it('les notes prof sont bien associées aux copies 101-103', () => {
+    const recap = parserRecap('eleve_101 | 4.5\neleve_102 | 11.5\neleve_103 | 16');
+    const copies = [101, 102, 103].map((n) => ({ fichier: `eleve_${n}.txt`, texte: copieComplete() }));
+    const { stats, resultats } = evaluerBatch(copies, recap);
+    expect(stats.nAvecProf).toBe(3);
+    expect(resultats.every((r) => r.noteProf !== undefined)).toBe(true);
+  });
+});
+
+describe('M3 — la note prof dans le fichier de copie', () => {
+  it('« SCORE: 11.5/20 » (forme du README) n’est PAS lu', () => {
+    expect(parserScoreAttendu('réponse\nSCORE: 11.5/20')).toBeNull();
+  });
+
+  it('la forme réellement lue : SCORE ATTENDU + Exercice N + TOTAL', () => {
+    const bloc =
+      'SCORE ATTENDU\n- Exercice 1 : 4/5\n- Exercice 2 : 5/7\n- Exercice 3 : 2.5/8\n- TOTAL : 11.5/20';
+    expect(parserScoreAttendu('réponse\n' + bloc)?.total).toBe(11.5);
+    expect(couperBlocScore('réponse\n' + bloc)).toBe('réponse\n');
+  });
+});
