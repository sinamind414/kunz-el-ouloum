@@ -0,0 +1,109 @@
+// ============================================================
+// Tests COMPORTEMENTAUX des 3 défauts 🔴 du lot M4 (Web Push).
+// Contrairement aux verrous de chaîne source, ceux-ci EXÉCUTENT le
+// middleware JWT et le vrai Service Worker dans un bac à sable.
+// ============================================================
+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import jwt from 'jsonwebtoken';
+import { makeStudentAuth, makeTeacherAuth } from '../../server/auth';
+
+const SECRET = 'secret-de-test-push-m4';
+const lire = (f: string) => fs.readFileSync(path.resolve(process.cwd(), f), 'utf-8');
+
+// ── 🔴 1 : diffusion ──────────────────────────────────────────────────
+function passer(middleware: (req: any, res: any, next: any) => void, token: string) {
+  const statuts: number[] = [];
+  let suivant = 0;
+  const res = {
+    status(code: number) { statuts.push(code); return this; },
+    json() { return this; },
+  };
+  middleware({ headers: { authorization: `Bearer ${token}` } }, res, () => { suivant += 1; });
+  return { statuts, suivant };
+}
+
+describe('🔴 1 — /api/push/send : un jeton ÉLÈVE ne franchit pas teacherAuth', () => {
+  it('jeton élève → 401 et middleware non franchi', () => {
+    const token = jwt.sign({ studentId: 'eleve-1', email: 'eleve@ecole.dz' }, SECRET);
+    const { statuts, suivant } = passer(makeTeacherAuth(SECRET), token);
+    expect(suivant).toBe(0);
+    expect(statuts).toContain(401);
+  });
+
+  it('jeton enseignant → le middleware laisse passer', () => {
+    const token = jwt.sign({ role: 'teacher', email: 'prof@ecole.dz' }, SECRET);
+    expect(passer(makeTeacherAuth(SECRET), token).suivant).toBe(1);
+  });
+
+  it('la route de diffusion est déclarée avec teacherAuth, jamais studentAuth', () => {
+    const src = lire('server.ts');
+    expect(src).toMatch(/app\.post\("\/api\/push\/send",\s*teacherAuth/);
+    expect(src).not.toMatch(/app\.post\("\/api\/push\/send",\s*studentAuth/);
+  });
+
+  it('réciproque : studentAuth refuse un jeton enseignant', () => {
+    const token = jwt.sign({ role: 'teacher', email: 'prof@ecole.dz' }, SECRET);
+    expect(passer(makeStudentAuth(SECRET), token).suivant).toBe(0);
+  });
+});
+
+// ── 🔴 3 : clic sur notification ──────────────────────────────────────
+type ClientFactice = { url: string; focus: () => Promise<void> };
+
+function chargerSW(clients: ClientFactice[]) {
+  const handlers: Record<string, (event: any) => void> = {};
+  const ouvertures: string[] = [];
+  const self = {
+    location: { href: 'https://app.example/sw.js', origin: 'https://app.example' },
+    addEventListener: (type: string, fn: (event: any) => void) => { handlers[type] = fn; },
+    registration: { showNotification: async () => undefined },
+    clients: {
+      matchAll: async () => clients,
+      openWindow: async (url: string) => { ouvertures.push(url); },
+    },
+  };
+  vm.runInNewContext(lire('public/sw.js'), {
+    self, URL, JSON, Promise, console, navigator: { connection: undefined },
+  });
+  return { handlers, ouvertures };
+}
+
+async function cliquer(handlers: Record<string, (e: any) => void>, url: string) {
+  let attente: Promise<unknown> | undefined;
+  handlers.notificationclick({
+    notification: { close: () => undefined, data: { url } },
+    waitUntil: (p: Promise<unknown>) => { attente = p; },
+  });
+  await attente;
+}
+
+describe('🔴 3 — notificationclick focalise/ouvre l’app, même avec url relative', () => {
+  it('url "/" + onglet déjà ouvert → focus(), sans exception', async () => {
+    let focalisations = 0;
+    const { handlers, ouvertures } = chargerSW([
+      { url: 'https://app.example/plan', focus: async () => { focalisations += 1; } },
+    ]);
+    await cliquer(handlers, '/');
+    expect(focalisations).toBe(1);
+    expect(ouvertures).toHaveLength(0);
+  });
+
+  it('aucun onglet → openWindow reçoit une URL ABSOLUE de la même origine', async () => {
+    const { handlers, ouvertures } = chargerSW([]);
+    await cliquer(handlers, '/');
+    expect(ouvertures).toHaveLength(1);
+    expect(ouvertures[0].startsWith('https://app.example/')).toBe(true);
+  });
+
+  it('URL absolue du serveur → aucune exception et focus()', async () => {
+    let focalisations = 0;
+    const { handlers } = chargerSW([
+      { url: 'https://app.example/', focus: async () => { focalisations += 1; } },
+    ]);
+    await cliquer(handlers, 'https://app.example/revision');
+    expect(focalisations).toBe(1);
+  });
+});
