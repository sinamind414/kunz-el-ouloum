@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+import {
+  horaireAlgerienAutorise,
+  horodatageIsoPush,
+  jourPush,
+  rappelDejaEnvoyeAujourdHui,
+} from './pushRappels';
+
+const MAINTENANT = new Date('2026-11-04T10:00:00.000Z'); // 11h à Alger
+
+describe('🔴 2 — la date PostgreSQL est normalisée ( quota 1/jour )', () => {
+  it('un objet Date (timestamptz pg) devient un ISO exploitable', () => {
+    expect(horodatageIsoPush(new Date('2026-11-04T09:30:00.000Z'))).toBe('2026-11-04T09:30:00.000Z');
+  });
+
+  it('LA FORME DU BUG : String(Date) = « Wed Nov 04 … » est comprise', () => {
+    const brut = String(new Date('2026-11-04T09:30:00.000Z'));
+    expect(brut.slice(0, 10)).not.toBe('2026-11-04'); // l'ancien code échouait ici
+    expect(jourPush(brut)).toBe('2026-11-04'); // le garde-fou, lui, passe
+  });
+
+  it('SQLite (ISO), Postgres (Date) et String(Date) donnent le MÊME jour', () => {
+    const iso = '2026-11-04T08:00:00.000Z';
+    const jours = [jourPush(iso), jourPush(new Date(iso)), jourPush(String(new Date(iso)))];
+    expect(jours).toEqual(['2026-11-04', '2026-11-04', '2026-11-04']);
+  });
+
+  it('valeurs absentes ou invalides → null (jamais de quota fantôme)', () => {
+    for (const v of [null, undefined, '', 'pas-une-date']) {
+      expect(horodatageIsoPush(v)).toBeNull();
+    }
+  });
+});
+
+describe('🔴 2 — le quota est réellement appliqué', () => {
+  it('même jour → rappel bloqué, quelle que soit la forme du store', () => {
+    const hier = '2026-11-04T08:00:00.000Z';
+    expect(rappelDejaEnvoyeAujourdHui(hier, MAINTENANT)).toBe(true);
+    expect(rappelDejaEnvoyeAujourdHui(new Date(hier), MAINTENANT)).toBe(true);
+    expect(rappelDejaEnvoyeAujourdHui(String(new Date(hier)), MAINTENANT)).toBe(true);
+  });
+
+  it('veille, absence et invalide → un rappel est autorisé', () => {
+    expect(rappelDejaEnvoyeAujourdHui('2026-11-03T23:00:00.000Z', MAINTENANT)).toBe(false);
+    expect(rappelDejaEnvoyeAujourdHui(null, MAINTENANT)).toBe(false);
+    expect(rappelDejaEnvoyeAujourdHui('pas-une-date', MAINTENANT)).toBe(false);
+  });
+});
+
+describe('plage horaire algérienne 08h-22h (UTC+1)', () => {
+  it('08h et 21h59 autorisées ; 07h59, 22h et 00h30 refusées', () => {
+    expect(horaireAlgerienAutorise(new Date('2026-11-04T07:00:00.000Z'))).toBe(true);
+    expect(horaireAlgerienAutorise(new Date('2026-11-04T20:59:00.000Z'))).toBe(true);
+    expect(horaireAlgerienAutorise(new Date('2026-11-04T06:59:00.000Z'))).toBe(false);
+    expect(horaireAlgerienAutorise(new Date('2026-11-04T21:00:00.000Z'))).toBe(false);
+    expect(horaireAlgerienAutorise(new Date('2026-11-04T23:30:00.000Z'))).toBe(false);
+  });
+});
diff --git a/server/pushRappels.ts b/server/pushRappels.ts
new file mode 100644
index 0000000..a3e29d8
--- /dev/null
+++ b/server/pushRappels.ts
@@ -0,0 +1,44 @@
+// ============================================================
+// pushRappels.ts — garde-fous PURS du rappel Web Push (M4, 🔴 2).
+//
+// Défaut mesuré : côté PostgreSQL, `listPushSubscriptions()` renvoyait
+// `String(row.derniere_notif)` sur un `timestamptz`, soit
+// « Wed Nov 04 2026 10:00:00 GMT+0000 … ». La comparaison
+// `slice(0, 10) === '2026-11-04'` était donc TOUJOURS fausse : le quota
+// « 1 notification / jour » n'existait pas en production Postgres.
+// SQLite stockait déjà l'ISO, d'où une parité trompeuse.
+//
+// Aucune dépendance (ni pg, ni Express, ni horloge cachée) : le serveur
+// ET les tests exécutent exactement les mêmes fonctions.
+// ============================================================
+
+/** Normalise Date JS, chaîne ISO ou `String(Date)` en horodatage ISO. */
+export function horodatageIsoPush(valeur: unknown): string | null {
+  if (valeur === null || valeur === undefined || valeur === '') return null;
+  const date = valeur instanceof Date ? valeur : new Date(String(valeur));
+  if (Number.isNaN(date.getTime())) return null;
+  return date.toISOString();
+}
+
+/** Jour UTC (YYYY-MM-DD) d'un horodatage, ou null si absent/invalide. */
+export function jourPush(valeur: unknown): string | null {
+  const iso = horodatageIsoPush(valeur);
+  return iso === null ? null : iso.slice(0, 10);
+}
+
+/** Vrai si le rappel a déjà été envoyé le jour (UTC) de `maintenant`. */
+export function rappelDejaEnvoyeAujourdHui(derniereNotif: unknown, maintenant: Date): boolean {
+  const aujourdhui = jourPush(maintenant);
+  return aujourdhui !== null && jourPush(derniereNotif) === aujourdhui;
+}
+
+/** Heure d'Alger (UTC+1, pas d'heure d'été en Algérie). */
+export function heureAlgerienne(maintenant: Date): number {
+  return maintenant.getUTCHours() + 1;
+}
+
+/** Pas d'envoi entre 22h et 08h, heure d'Alger. */
+export function horaireAlgerienAutorise(maintenant: Date): boolean {
+  const h = heureAlgerienne(maintenant);
+  return h >= 8 && h < 22;
+}
