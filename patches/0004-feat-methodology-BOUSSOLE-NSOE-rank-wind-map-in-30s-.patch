+import React, { useEffect, useState, useRef } from 'react';
+import { Compass, Clock, Play, X } from 'lucide-react';
+import { BOUSSOLE_CAPS, REGLE_D_OR_AR } from '../data/boussoleData';
+
+interface Props {
+  open: boolean;
+  onComplete: () => void; // appelé quand le compte à rebours touche 0 OU quand l'élève démarre
+}
+
+const RITUAL_SECONDS = 30;
+
+/**
+ * Rituel du navigateur : 30 secondes avant le cap EST (bac chronométré).
+ * L'élève passe les 4 caps en revue (gestes + questions mécaniques),
+ * puis l'aiguille se met en route vers l'est — ou il démarre directement.
+ */
+export default function RitualCompassModal({ open, onComplete }: Props) {
+  const [seconds, setSeconds] = useState(RITUAL_SECONDS);
+  const startedRef = useRef(false);
+
+  // Compte à rebours (remis à 30 à chaque ouverture)
+  useEffect(() => {
+    if (!open) {
+      setSeconds(RITUAL_SECONDS);
+      startedRef.current = false;
+      return;
+    }
+    const id = setInterval(() => setSeconds(s => Math.max(0, s - 1)), 1000);
+    return () => clearInterval(id);
+  }, [open]);
+
+  // Fin automatique à 0 (une seule fois)
+  useEffect(() => {
+    if (open && seconds === 0 && !startedRef.current) {
+      startedRef.current = true;
+      onComplete();
+    }
+  }, [open, seconds, onComplete]);
+
+  if (!open) return null;
